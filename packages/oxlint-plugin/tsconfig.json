{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./lib",
    "skipLibCheck": true,
    "sourceMap": false
  },
  "include": ["./lib/**/*.ts"]
}
